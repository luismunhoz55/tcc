# Copie este arquivo para .env e preencha os valores do app Web criado no Firebase.
# Variáveis EXPO_PUBLIC_ são visíveis no aplicativo: nunca inclua chaves administrativas.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_DATABASE_URL=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
